{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Usage Notch",
  "version": "0.1.0",
  "identifier": "dev.codexusagenotch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Usage Notch",
        "width": 480,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
